# ---- Environment & secrets ----
.env
.env.*
!.env.example
*.local
.secrets/
data/secrets/

# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Builds ----
frontend/dist/
frontend/dist-ssr/
*.tsbuildinfo
build/
out/

# ---- Runtime data (never commit) ----
data/
*.db
*.db-journal
*.db-wal
*.db-shm
uploads/*
!uploads/.gitkeep
generated/images/*
!generated/images/.gitkeep
generated/videos/*
!generated/videos/.gitkeep

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- OS / editor ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo

# ---- Test / cache ----
coverage/
.nyc_output/
.cache/
.parcel-cache/
.vite/
