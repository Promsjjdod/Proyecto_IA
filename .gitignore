# dependencies
node_modules/

# The compiled interface (`public/build`) and the vendored runtime artifacts
# (`public/vendor`) ARE versioned on purpose: the distributed zip must run even when
# `npm install` cannot execute its scripts, and the server only rebuilds them as an
# improvement (see AppContext: the build step is not critical when verify() passes).
# user data: scripts, settings, themes, history, logs (created at runtime)
data/

# native interpreters built from source by scripts/setup.mjs
tools/bin/

# OS / editor noise
.DS_Store
Thumbs.db
*.log
.tmp/
