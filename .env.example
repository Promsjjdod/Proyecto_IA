# Copy to .env. Use a long random value (32+ bytes) for encryption/session safety.
NODE_ENV=development
# Bind to this machine only for local use. Use 0.0.0.0 only when intentionally exposing the app to a trusted network.
HOST=127.0.0.1
PORT=4000
DATA_DIR=./data
# Required in production. In development only, a non-secret fallback is used with a warning.
PROVIDER_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters
# Optional one-time bootstrap administrator. Created only if this email does not exist.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Ollama is restricted to these exact origins (including port) by default. Add a trusted LAN origin explicitly if needed.
OLLAMA_ALLOWED_URLS=http://localhost:11434,http://127.0.0.1:11434,http://[::1]:11434
# HTTP workflow node can only reach explicitly listed public HTTPS hostnames.
WORKFLOW_HTTP_ALLOWED_HOSTS=
# Optional comma-separated provider types permitted for user connections.
ALLOWED_PROVIDER_TYPES=openai,anthropic,google,deepseek,ollama,openai-compatible,custom
