# ============================================================
# ForgeAI - environment configuration
# Copy this file to `.env` and adjust. NEVER commit real values.
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)
# ============================================================

# ---- Core ----
# Bind host for the backend API. 127.0.0.1 = this machine only (safe default).
FORGEAI_HOST=127.0.0.1
FORGEAI_PORT=8000
# Frontend dev server port
FORGEAI_FRONTEND_PORT=3000
# "development" | "production" | "test"
FORGEAI_ENV=development
# Log level: DEBUG | INFO | WARN | ERROR
FORGEAI_LOG_LEVEL=INFO

# ---- LAN access ----
# Set to "true" to expose the app to your local network (e.g. phone / laptop).
# This binds to 0.0.0.0 on your LAN interface only; it never opens Internet ports.
FORGEAI_LAN=false

# ---- CORS ----
# Comma separated list of allowed origins. "*" disables the allow-list (not recommended).
FORGEAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database ----
# SQLite file location (created automatically on first run).
FORGEAI_DB_PATH=data/forgeai.db

# ---- Security ----
# Used to sign session cookies and encrypt stored secrets (GitHub tokens...).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGEAI_SECRET_KEY=change-me-to-a-64-char-hex-string
# Optional local password. When empty, ForgeAI runs as a trusted single-user
# local app (auto sign-in). When set, a login screen is shown.
FORGEAI_AUTH_PASSWORD=
# Rate limiting (per IP, per minute) for API routes.
FORGEAI_RATE_LIMIT_MAX=600

# ---- Demo mode ----
# When no provider is configured ForgeAI automatically falls back to a clearly
# labelled built-in DEMO provider so the UI stays explorable. Set to "false"
# to disable that fallback.
FORGEAI_DEMO_MODE=true

# ---- Providers (all optional) ----
# Any OpenAI-compatible endpoint (OpenAI, OpenRouter, LM Studio, llama.cpp,
# Together, Groq, vLLM, ...). Add more providers from Settings > Providers.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Native Ollama support. Point at your Ollama instance if you run one.
OLLAMA_BASE_URL=http://localhost:11434

# ---- Image generation (optional) ----
# OpenAI-compatible /images/generations endpoint (or leave empty = not configured).
IMAGE_PROVIDER_BASE_URL=
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_MODEL=

# ---- GitHub OAuth (optional) ----
# Create an OAuth App at https://github.com/settings/developers
#   Authorization callback URL:  http://localhost:8000/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Alternative (no OAuth app needed): a Personal Access Token, stored encrypted.
GITHUB_PAT=

# ---- Tools / permissions ----
# Comma separated allow-list of tool permission groups enabled by default.
# READ_FILES,WRITE_FILES,EXECUTE_COMMANDS,NETWORK_ACCESS,GITHUB_ACCESS
FORGEAI_TOOL_PERMISSIONS=READ_FILES,NETWORK_ACCESS
# Root folder the filesystem tools may touch (default: repository root).
FORGEAI_WORKSPACE_ROOT=
# Commands the terminal tool may run must match this pattern (basic injection guard).
FORGEAI_TERMINAL_ALLOWLIST=ls,cat,rg,grep,node,npm,git,python3,tsc,vite
