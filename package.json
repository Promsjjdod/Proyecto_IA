{
  "name": "forgeai",
  "version": "0.1.0",
  "private": true,
  "description": "ForgeAI - local AI workspace: chat, agents, plugins, tools, files, image/video generation and automation, served from your own machine.",
  "keywords": [
    "ai",
    "workspace",
    "agents",
    "plugins",
    "ollama",
    "local-first",
    "chat"
  ],
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:lan": "node scripts/dev.mjs --lan",
    "server": "node scripts/dev.mjs --backend-only",
    "client": "node scripts/dev.mjs --frontend-only",
    "start": "node scripts/start.mjs",
    "build": "npm run build --workspace frontend",
    "migrate": "node scripts/migrate.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "test": "node scripts/test.mjs",
    "test:backend": "npm run test --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend",
    "doctor": "node scripts/doctor.mjs"
  }
}
