{
  "name": "proyecto-ia",
  "productName": "Lumen Studio",
  "version": "1.0.0",
  "description": "Professional Lua/Luau script execution and editing environment (real Luau & Lua 5.4 runtimes, CodeMirror 6 editor, plugin system).",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --watch",
    "serve": "node src/server/index.js",
    "build": "node scripts/build.mjs",
    "desktop": "electron src/main/main.js",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/",
    "test:watch": "node --test --watch tests/",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@luau-rs/luau": "^0.739.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "wasmoon": "^1.16.0"
  },
  "optionalDependencies": {
    "electron": "^33.0.0"
  },
  "keywords": [
    "lua",
    "luau",
    "ide",
    "editor",
    "runtime",
    "codemirror"
  ],
  "license": "MIT"
}
