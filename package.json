{
  "name": "nexus-ai-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "A secure, self-hosted multi-model AI workspace.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "db:init": "tsx server/scripts/init-db.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "simple-icons": "^16.34.0",
    "sql.js": "^1.13.0",
    "tsx": "^4.23.15",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
