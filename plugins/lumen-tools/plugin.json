{
  "id": "lumen-tools",
  "name": "Herramientas de Lumen",
  "version": "1.0.0",
  "apiVersion": 1,
  "author": "Lumen Studio",
  "description": "Utilidades de trabajo diario: inserta una cabecera Luau, informa del estado real de la sesión y alterna el ajuste de línea desde la paleta de comandos.",
  "license": "MIT",
